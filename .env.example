NODE_ENV=production
PORT=3000

# Optional shared queue backend. When configured, API and workers share jobs through Redis.
REDIS_URL=
QUEUE_REDIS_KEY=toolkitpro:jobs
QUEUE_JOB_PREFIX=toolkitpro:job:
WORKER_INTERVAL_MS=250

# Optional PostgreSQL-backed tool registry. Leave empty to use the static registry fallback.\nDATABASE_URL=\nTOOL_REGISTRY_TABLE=tool_registry\nDB_POOL_MAX=10\n