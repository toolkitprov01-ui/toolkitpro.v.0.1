{
  "name": "toolkit-pro",
  "version": "2.2.0",
  "private": true,
  "description": "Toolkit Pro - simple free online tools",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "worker": "node workers/example-worker.js",
    "test": "node --test test && npm run validate:modules",
    "db:seed": "node scripts/seed-tool-registry.js",
    "test:syntax": "node --check server.js && node --check lib/job-queue.js && node --check workers/example-worker.js",
    "validate:modules": "node scripts/validate-tool-modules.js",
    "test:registry": "node --test test/tool-registry.test.js",
    "test:all": "npm test && npm run test:syntax"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "redis": "^5.8.3",
    "pg": "^8.16.3"
  }
}
